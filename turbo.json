{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:watch": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "persistent": true
    },
    "lint": {
      "dependsOn": ["build"]
    },
    "dev": {
      "dependsOn": ["lint"],
      "persistent": true
    }
  }
}
