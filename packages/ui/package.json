{
  "name": "custom-plus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/ui.umd.js",
  "module": "./dist/ui.es.js",
  "types": "./dist/ui.es.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ui.es.d.ts",
      "import": "./dist/ui.es.js",
      "require": "./dist/ui.umd.js"
    },
    "./dist/main.css": "./dist/main.css",
    "./styles/button.css": "./dist/main.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:watch": "vue-tsc -b && vite build --watch",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix"
  },
  "dependencies": {
    "@custom-plus/components": "workspace:*",
    "element-plus": "^2.13.0",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "typescript": "~5.9.3",
    "unocss": "^66.5.10",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.4"
  }
}
